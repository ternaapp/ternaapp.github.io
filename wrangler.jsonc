// Terna Jobs · cómo publica Cloudflare la web (terna-motor/docs/plan-cloudflare.md §4.6). No es un build: los archivos se
// sirven tal cual. Qué se publica lo dice .assetsignore (una lista de lo que SÍ va); las cabeceras, _headers; la raíz, _redirects.
{
  "name": "terna-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    // /contratar.html se sirve como /contratar.html: sin esto Cloudflare redirige a /contratar y cambian todas las direcciones.
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // Los nombres que sirven la web (agregados en el panel el 24/11/2026; anotados acá para que el archivo diga la verdad).
  // www.ternajobs.com lleva a ternajobs.com con la regla R1 de la zona (Rules › Redirect Rules), que corre antes que los archivos.
  "routes": [
    { "pattern": "ternajobs.com", "custom_domain": true },
    { "pattern": "www.ternajobs.com", "custom_domain": true }
  ],
  // Sin dirección de prueba terna-web.<cuenta>.workers.dev: las reglas de la zona y Access no la cubren (plan-cloudflare.md §8.1).
  "workers_dev": false,
  "preview_urls": false
}
